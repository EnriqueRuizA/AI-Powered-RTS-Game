; data/base/units/general.unit - General
; Unidad base del juego (D1 data-driven). Valores golden identicos a
; initBuiltinTypes() en src/elements.cpp: si falta este archivo o alguna
; clave, el juego mantiene el builtin y avisa por consola/battleLog con
; archivo:linea (parser: src/gamedata.cpp).
; requires = mascara de bits: 0=Barracks 1=Stable 2=Range 3=Smithy 4=Workshop
;           (tambien acepta nombres: "Barracks, Smithy")
; weapon   = 0=spear 1=axe 2=poleaxe 3=hammer
; sprite   = Infantry | Cavalry | Ranged    color = R G B
schema   = 1
name     = General
soldiers  = 1
hp        = 150.0
armor     = 25
speed     = 80
melee.attack   = 45
melee.defense  = 35
melee.base     = 20.0
melee.ap       = 8.0
melee.interval = 1.2
range          = 0
missile.base   = 0.0
missile.ap     = 0.0
missile.reload = 0.0
recruit.gold   = -1
recruit.food   = -1
recruit.iron   = -1
recruit.turns  = -1
maint.gold     = 8
maint.food     = 4
morale         = 96.0
color    = 210 175 90
sprite   = Infantry
weapon   = 1
requires = 0
builtin  = 1
lore     = A battlefield commander. Required to lead a field army.
